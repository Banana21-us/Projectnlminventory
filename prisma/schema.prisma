generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users & auth ────────────────────────────────────────────────

enum Role {
  ADMIN
  STAFF
  GUESTHOUSE
}

model User {
  id                 String     @id @default(cuid())
  name               String
  email              String     @unique
  password           String
  role               Role       @default(STAFF)
  active             Boolean    @default(true)
  mustChangePassword Boolean    @default(false)
  createdById        String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  movements          Movement[]
  bookings           Booking[]
  roomBlocks         RoomBlock[]
  payments           Payment[]
  adjustments        FolioAdjustment[]
  bookingEvents      BookingEvent[]
  guesthouseLocks    GuesthouseSettings[]
}

// ── Catalog ─────────────────────────────────────────────────────

enum CategoryType {
  BOOK
  MATERIAL
  SUPPLY
  ASSET
}

model Category {
  id     String       @id @default(cuid())
  name   String       @unique
  type   CategoryType
  active Boolean      @default(true)
  items  Item[]
}

model Stockroom {
  id        String      @id @default(cuid())
  name      String      @unique
  active    Boolean     @default(true)
  stocks    ItemStock[]
  movements Movement[]
}

model Item {
  id           String      @id @default(cuid())
  name         String
  model        String? // product model / edition, e.g. "3rd Edition" or "Sun King Pro 400"
  categoryId   String
  category     Category    @relation(fields: [categoryId], references: [id])
  unit         String      @default("pcs")
  // Money: avgCost maintained by weighted average on RECEIVE;
  // movements snapshot cost/price so history never changes.
  sellingPrice Decimal     @default(0) @db.Decimal(10, 2)
  avgCost      Decimal     @default(0) @db.Decimal(10, 2)
  minStock     Int         @default(0)
  frequent     Boolean     @default(false)
  // Per-unit serial tracking (assets only). When true, stock is issued and
  // returned by specific AssetUnit, not just quantity.
  serialized   Boolean     @default(false)
  notes        String?
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  stocks       ItemStock[]
  movements    Movement[]
  assetUnits   AssetUnit[]
}

/// Per-stockroom stock level of an item. `quantity` is authoritative and
/// kept in lockstep with the sum of this row's Batch.qtyOnHand inside every
/// mutation transaction (see lib/stock.ts) — batches are lot/expiry detail,
/// not a second source of truth.
model ItemStock {
  id          String      @id @default(cuid())
  itemId      String
  item        Item        @relation(fields: [itemId], references: [id])
  stockroomId String
  stockroom   Stockroom   @relation(fields: [stockroomId], references: [id])
  shelf       String      @default("")
  quantity    Int         @default(0)
  maxStock    Int         @default(0)
  batches     Batch[]
  assetUnits  AssetUnit[]

  @@unique([itemId, stockroomId])
}

/// One receipt of stock into a stockroom. Dispensing drains batches FEFO
/// (earliest expiry first) when any batch on the item has an expiry, else
/// FIFO (earliest received first).
model Batch {
  id          String      @id @default(cuid())
  itemStockId String
  itemStock   ItemStock   @relation(fields: [itemStockId], references: [id])
  code        String // lot / batch label, e.g. "B-260712-A"
  qtyReceived Int
  qtyOnHand   Int
  receivedAt  DateTime    @default(now())
  expiry      DateTime?
  note        String?
  assetUnits  AssetUnit[]
  lines       MovementLine[]

  @@index([itemStockId])
}

enum AssetUnitStatus {
  IN_STOCK
  ISSUED
  WRITTEN_OFF
}

/// One physical, individually serialed unit of a serialized Item.
model AssetUnit {
  id      String          @id @default(cuid())
  itemId  String
  item    Item            @relation(fields: [itemId], references: [id])
  stockId String? // current ItemStock (stockroom) location; null once written off
  stock   ItemStock?      @relation(fields: [stockId], references: [id])
  batchId String?
  batch   Batch?          @relation(fields: [batchId], references: [id])
  serial  String
  status  AssetUnitStatus @default(IN_STOCK)
  lines   MovementLine[]

  @@unique([itemId, serial])
}

// ── Recipients ──────────────────────────────────────────────────

model District {
  id         String      @id @default(cuid())
  name       String      @unique
  active     Boolean     @default(true)
  recipients Recipient[]
}

enum RecipientType {
  PASTOR
  CHURCH
  MEMBER
  DEPARTMENT
  GUESTHOUSE
  OTHER
}

model Recipient {
  id         String        @id @default(cuid())
  name       String
  type       RecipientType @default(OTHER)
  email      String? // optional — used to email a dispense notice, mainly for PASTOR/GUESTHOUSE
  districtId String?
  district   District?     @relation(fields: [districtId], references: [id])
  active     Boolean       @default(true)
  createdAt  DateTime      @default(now())
  movements  Movement[]
  // Guesthouse: a GUESTHOUSE recipient can be a repeat guest, and a
  // DEPARTMENT recipient can be the payer on a charged-to-office stay.
  bookings   Booking[]     @relation("BookingGuest")
  paying     Payment[]     @relation("PaymentPayer")
}

// ── Movements (single audited ledger) ───────────────────────────

enum MovementType {
  RECEIVE
  DISPENSE
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  WRITE_OFF
  RETURN
}

enum WriteOffReason {
  DAMAGED
  WET
  SPOILED
  EXPIRED
  LOST
  OTHER
}

model Movement {
  id             String           @id @default(cuid())
  itemId         String
  item           Item             @relation(fields: [itemId], references: [id])
  stockroomId    String
  stockroom      Stockroom        @relation(fields: [stockroomId], references: [id])
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  type           MovementType
  purpose        String?
  recipientId    String?
  recipient      Recipient?       @relation(fields: [recipientId], references: [id])
  issuedToName   String?
  qty            Int
  unitCost       Decimal          @default(0) @db.Decimal(10, 2)
  unitPrice      Decimal?         @db.Decimal(10, 2)
  // SRP snapshot at dispense/sale time — independent of unitPrice (what was
  // actually charged), so a later price change never rewrites history and a
  // discount/free give-away can always be recomputed as listPrice - unitPrice.
  listPrice      Decimal?         @db.Decimal(10, 2)
  orNumber       String?
  reference      String?
  // Set on WRITE_OFF (direct or via a bad-condition RETURN).
  writeOffReason WriteOffReason?
  note           String?
  // Set when a DISPENSE/SALE is voided; the compensating ADJUSTMENT row
  // (reference = this movement's id) carries who/when/why. Ledger stays
  // append-only — nothing is ever deleted.
  cancelledAt    DateTime?
  createdAt      DateTime         @default(now())
  lines          MovementLine[]

  @@index([itemId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
}

/// Which batch (and, for serialized items, which unit) a movement drew
/// from or restocked into. Lets returns and write-offs put stock back into
/// / take it from the exact lot it came from, and shows lot/serial detail
/// in the log.
model MovementLine {
  id          String     @id @default(cuid())
  movementId  String
  movement    Movement   @relation(fields: [movementId], references: [id])
  batchId     String
  batch       Batch      @relation(fields: [batchId], references: [id])
  qty         Int
  assetUnitId String?
  assetUnit   AssetUnit? @relation(fields: [assetUnitId], references: [id])

  @@index([movementId])
}

// ── Guesthouse ──────────────────────────────────────────────────
//
// Two append-only ledgers hang off a Booking: `Payment` (cash in/out) and
// `FolioAdjustment` (discounts and extra charges). Nothing in either is ever
// edited or deleted — a refund is a negative payment, a correction is a new
// row. Everything else is derived:
//
//   charge   = nightlyRate × billedNights   (0 when complimentary)
//   netTotal = charge − discounts + charges
//   balance  = netTotal − payments
//
// Room occupancy is derived too, from BookingRoomStay + RoomBlock — never
// from a hand-set flag. All booking/room state changes go through
// src/lib/booking.ts, the way stock changes go through src/lib/stock.ts.

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

model Room {
  id            String            @id @default(cuid())
  name          String            @unique
  // Current default nightly rate. Bookings snapshot this at creation, so
  // changing it never rewrites history (same rule as Movement.unitCost).
  rate          Decimal           @default(0) @db.Decimal(10, 2)
  capacity      Int?
  notes         String?
  active        Boolean           @default(true)
  // Indefinite out-of-service. Dated repairs use RoomBlock instead, so
  // nobody has to remember to clear a flag.
  outOfService  Boolean           @default(false)
  needsCleaning Boolean           @default(false)
  bookings      Booking[]
  stays         BookingRoomStay[]
  blocks        RoomBlock[]
}

/// A room held out of service for a date range (repairs, deep clean).
model RoomBlock {
  id          String   @id @default(cuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id])
  fromDate    DateTime @db.Date
  toDate      DateTime @db.Date // exclusive, like checkOut
  reason      String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([roomId, fromDate])
}

enum BookingStatus {
  PENDING // tentative hold — holds the room, can expire
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

model Booking {
  id           String        @id @default(cuid())
  roomId       String
  room         Room          @relation(fields: [roomId], references: [id])
  guestName    String
  contact      String?
  // Optional link to a GUESTHOUSE recipient — enables email notices and
  // ties repeat guests together.
  recipientId  String?
  recipient    Recipient?    @relation("BookingGuest", fields: [recipientId], references: [id])
  // Set on every booking made in one multi-room flow (district meetings).
  groupId      String?
  groupName    String?

  // Date-only: the server runs UTC on Vercel while guests are Asia/Manila,
  // so a local-midnight DateTime would shift the stay by a day.
  checkIn      DateTime      @db.Date
  checkOut     DateTime      @db.Date // exclusive
  // `nights` is the reservation of record and never changes; `billedNights`
  // is what money is computed from and may be corrected after checkout.
  nights       Int
  billedNights Int
  nightlyRate  Decimal       @db.Decimal(10, 2)
  occupants    Int           @default(1)
  // Headcount actually observed at arrival, when it differs from what was
  // booked (e.g. booked for 3, 8 show up). Flag only — no price impact.
  actualOccupants Int?

  status       BookingStatus @default(CONFIRMED)
  // Only meaningful while PENDING: the day the tentative hold lapses.
  holdUntil    DateTime?     @db.Date

  // Complimentary stays (visiting workers, speakers) bill nothing but keep
  // their nightlyRate, so accounting can report the notional value given.
  complimentary Boolean      @default(false)
  compReason    String?

  cancelReason   String?
  actualCheckIn  DateTime?
  actualCheckOut DateTime?
  note           String?

  createdById  String
  createdBy    User          @relation(fields: [createdById], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  payments     Payment[]
  adjustments  FolioAdjustment[]
  events       BookingEvent[]
  stays        BookingRoomStay[]

  @@index([roomId, checkIn])
  @@index([status, checkIn])
  @@index([checkIn])
  @@index([groupId])
}

/// One row per room a booking occupied. Normally one; a mid-stay room move
/// closes the first and opens a second. Availability is computed from these.
model BookingRoomStay {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id])
  fromDate  DateTime @db.Date
  toDate    DateTime @db.Date // exclusive
  reason    String?
  // The room's rate snapshotted when this segment was created (at booking,
  // or at a room move) — same discipline as Movement.unitCost, so a later
  // rate change never rewrites a past folio. Billing sums nights × rate per
  // segment, so moving to a differently-priced room actually changes what's
  // charged for the nights after the move.
  rate      Decimal  @default(0) @db.Decimal(10, 2)

  @@index([roomId, fromDate])
  @@index([bookingId])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  GCASH
  CHECK
  CHARGE_TO_DEPARTMENT
  OTHER
}

/// Append-only cash ledger. Negative amounts are refunds (ADMIN only).
model Payment {
  id           String        @id @default(cuid())
  bookingId    String
  booking      Booking       @relation(fields: [bookingId], references: [id])
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod
  // Set when method is CHARGE_TO_DEPARTMENT: the department/district that
  // owes it. Unsettled rows are the guesthouse's receivables.
  payerId      String?
  payer        Recipient?    @relation("PaymentPayer", fields: [payerId], references: [id])
  settledAt    DateTime?
  orNumber     String?
  reference    String?
  note         String?
  paidAt       DateTime      @default(now())
  recordedById String
  recordedBy   User          @relation(fields: [recordedById], references: [id])
  createdAt    DateTime      @default(now())

  @@index([bookingId])
  @@index([paidAt])
}

enum AdjustmentKind {
  DISCOUNT // reduces what's owed — peso amount, ADMIN only, before payment
  CHARGE // adds to what's owed — damages, laundry, replaced key
}

/// Append-only folio ledger. Never edited; a mistake is corrected by a new
/// row in the opposite direction.
model FolioAdjustment {
  id          String         @id @default(cuid())
  bookingId   String
  booking     Booking        @relation(fields: [bookingId], references: [id])
  kind        AdjustmentKind
  amount      Decimal        @db.Decimal(10, 2) // always positive; `kind` gives direction
  reason      String
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())

  @@index([bookingId])
  @@index([createdAt])
}

enum BookingEventType {
  CREATED
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
  ROOM_CHANGED
  DATES_CHANGED
  EXTENDED
  NIGHTS_ADJUSTED
  DISCOUNT_APPLIED
  CHARGE_ADDED
  PAYMENT_RECORDED
  REFUND_RECORDED
  COMPED
  RECEIVABLE_SETTLED
  OCCUPANTS_CHANGED
}

/// Audit trail — answers "who cancelled this?" and "why is this stay ₱2,000
/// when it was booked for four nights?" without guesswork.
model BookingEvent {
  id         String           @id @default(cuid())
  bookingId  String
  booking    Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type       BookingEventType
  fromStatus BookingStatus?
  toStatus   BookingStatus?
  detail     String?
  actorId    String
  actor      User             @relation(fields: [actorId], references: [id])
  createdAt  DateTime         @default(now())

  @@index([bookingId, createdAt])
}

/// Singleton (id "default"). `lockedThrough` freezes every stay and payment
/// on or before that date so a filed treasurer's report stays reproducible.
model GuesthouseSettings {
  id            String    @id @default("default")
  lockedThrough DateTime? @db.Date
  lockedById    String?
  lockedBy      User?     @relation(fields: [lockedById], references: [id])
  updatedAt     DateTime  @updatedAt
}
